{
  "name": "@mrquake/quakecode-agent-core",
  "version": "1.11.2",
  "description": "Quake Code agent runtime with transport abstraction, state management, and tool execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "vitest --run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@mrquake/quakecode-ai": "^1.11.2",
    "@sinclair/typebox": "^0.34.41"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "transport",
    "state-management"
  ],
  "author": "MrQuake",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}

