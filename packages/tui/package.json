{
  "name": "@mrquake/quakecode-tui",
  "version": "1.11.2",
  "description": "Quake Code terminal UI library with differential rendering for text-based applications",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "tsgo -p tsconfig.build.json",
    "dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
    "test": "node --test --import tsx test/*.test.ts",
    "mouse:smoke": "node --test --import tsx test/mouse.test.ts test/spatial-index.test.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "keywords": [
    "tui",
    "terminal",
    "ui",
    "text-editor",
    "differential-rendering",
    "typescript",
    "cli"
  ],
  "author": "MrQuake",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@types/mime-types": "^2.1.4",
    "chalk": "^5.5.0",
    "get-east-asian-width": "^1.3.0",
    "marked": "^15.0.12",
    "mime-types": "^3.0.1"
  },
  "optionalDependencies": {
    "koffi": "^3.1.4"
  },
  "devDependencies": {
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0"
  }
}
