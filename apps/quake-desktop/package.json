{
  "name": "@mrquake/quake-desktop",
  "productName": "Quake Code",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "description": "Quake Code Desktop — a local-first command center for coding agents.",
  "author": "Quake Code",
  "scripts": {
    "dev": "npm run desktop:dev",
    "dev:server": "tsx src/server/index.ts",
    "dev:server:grok": "cross-env QUAKE_CODE_CODING_AGENT_DIR=%USERPROFILE%\\.grok\\agent tsx src/server/index.ts",
    "dev:client": "vite --config vite.config.ts --host 127.0.0.1 --port 5173",
    "realtime:lab": "node gpt-realtime-tester/server.js",
    "account:provision-admin": "tsx scripts/provision-admin.mts",
    "build": "tsgo -p tsconfig.json && vite build --config vite.config.ts",
    "typecheck": "tsgo -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/server/index.js",
    "desktop:build:main": "tsc -p tsconfig.electron.json && node scripts/electron-cjs-marker.mjs",
    "desktop:brand-electron": "node scripts/ensure-branded-electron.mjs",
    "desktop:dev": "npm run desktop:build:main && concurrently -n server,web,electron -c green,cyan,magenta \"cross-env QUAKE_BROWSER_EMBEDDED=1 QUAKE_BROWSER_BRIDGE_PORT=9223 QUAKE_CDP_PORT=9222 QUAKE_COMPUTER_USE_BRIDGE_PORT=9224 tsx scripts/run-desktop-server.mjs\" \"vite --config vite.config.ts --host 127.0.0.1 --port 5173 --strictPort\" \"node scripts/run-electron-dev.mjs\"",
    "desktop:electron": "npm run desktop:build:main && node scripts/run-electron-dev.mjs",
    "desktop:build:runtime": "npm --prefix ../../packages/tui run build && npm --prefix ../../packages/ai run build && npm --prefix ../../packages/agent run build && npm --prefix ../../packages/jiti run build && npm --prefix ../../packages/coding-agent run build",
    "desktop:build:production": "npm run desktop:build:runtime && npm run build && npm run desktop:build:main",
    "desktop:pack:win": "npm run desktop:build:production && electron-builder --config electron-builder.yml --dir --win --x64",
    "desktop:package:win": "npm run desktop:build:production && electron-builder --config electron-builder.yml --win nsis --x64 && node scripts/finalize-windows-release.mjs",
    "pretest": "node scripts/ensure-runtime-built.mjs",
    "test": "vitest run --config vitest.config.ts",
    "desktop:start": "npm run build && npm run desktop:build:main && node scripts/run-electron-dev.mjs",
    "smoke": "node scripts/smoke.mjs",
    "computer-use:smoke": "node scripts/computer-use-smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test test/e2e/smoke.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "audit:prod": "npm audit --omit=dev --workspace @mrquake/quake-desktop",
    "ship-gate": "node scripts/ship-gate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@mrquake/quakecode-agent-core": "^1.11.2",
    "@mrquake/quakecode-ai": "^1.11.2",
    "@mrquake/quakecode-cli": "^1.11.2",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.5.0",
    "cmdk": "^1.1.1",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.1",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.56.0",
    "motion": "^12.43.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^4.11.2",
    "react-virtuoso": "^4.18.10",
    "shiki": "^4.4.1",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.1",
    "use-stick-to-bottom": "^1.1.6",
    "ws": "^8.21.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "42.2.0",
    "electron-builder": "^26.15.3",
    "rcedit": "^5.0.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
