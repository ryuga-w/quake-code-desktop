# Copy this file to .env.local. Never commit the populated file.
# Use a freshly rotated Azure key; do not reuse a key that appeared in a prototype or chat.

AZURE_REALTIME_ENDPOINT=https://your-resource.openai.azure.com
AZURE_REALTIME_DEPLOYMENT=gpt-realtime-2.1
AZURE_REALTIME_API_KEY=replace-with-a-rotated-key

# "v1" follows the current Azure OpenAI v1 Realtime route.
# Use "legacy" when Azure supplied a deployment-path Realtime URL, for example
# .../openai/realtime/deployments/<deployment>?api-version=<version>.
AZURE_REALTIME_API_MODE=v1
AZURE_REALTIME_API_VERSION=2024-10-21-preview

REALTIME_LAB_HOST=127.0.0.1
REALTIME_LAB_PORT=3001
