{
  "name": "quake-code-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Quake Code Desktop — a local-first command center for coding agents.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuga-w/quake-code-desktop.git"
  },
  "workspaces": [
    "apps/quake-desktop",
    "packages/ai",
    "packages/agent",
    "packages/coding-agent",
    "packages/clipboard",
    "packages/jiti",
    "packages/openclaw-core",
    "packages/openclaw-driver-win32",
    "packages/openclaw-prism",
    "packages/tui"
  ],
  "scripts": {
    "desktop:dev": "npm run desktop:dev --workspace=@mrquake/quake-desktop",
    "desktop:build": "npm run desktop:build:production --workspace=@mrquake/quake-desktop",
    "desktop:package:win": "npm run desktop:package:win --workspace=@mrquake/quake-desktop",
    "test": "npm run test --workspace=@mrquake/quake-desktop",
    "typecheck": "npm run desktop:build:runtime --workspace=@mrquake/quake-desktop && npm run typecheck --workspace=@mrquake/quake-desktop",
    "verify:public-source": "node scripts/verify-public-source.mjs",
    "ship-gate": "npm run ship-gate --workspace=@mrquake/quake-desktop"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "shx": "^0.4.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "rimraf": "6.1.2",
    "fast-xml-parser": "5.5.10",
    "form-data": "4.0.6",
    "shell-quote": "1.10.0",
    "protobufjs": "7.6.5",
    "undici": "7.29.0",
    "vite": "7.3.6",
    "gaxios": {
      "rimraf": "6.1.2"
    }
  }
}
